# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/
.eggs/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Local databases
*.db
*.sqlite3
*.db-journal

# IDE / editor
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Media source files (raw pipeline inputs — not needed at runtime)
audios/
videos/
*.mp3
*.wav
*.flac
*.mp4
*.mov

# --- Runtime artifacts: KEEP these tracked, do NOT ignore ---
# embeddings.joblib and tfidf_vectorizer.joblib are intentionally
# committed because the live app loads them directly on Render.
# !embeddings.joblib
# !tfidf_vectorizer.joblib